/* =====================================================
   DARK MODE - FIX TEXT VISIBILITY
   ===================================================== */

body.dark-mode {
    background: #0f1820 !important;
    color: #f1f5f9 !important;
}

/* Semua tajuk */
body.dark-mode h1,
body.dark-mode h2,
body.dark-mode h3,
body.dark-mode h4,
body.dark-mode h5,
body.dark-mode h6 {
    color: #f8fafc !important;
}

/* Subtitle */
body.dark-mode .page-subtitle,
body.dark-mode .subtitle {
    color: #b8c5d1 !important;
}

/* Panel / Card */
body.dark-mode .panel,
body.dark-mode .card,
body.dark-mode .stat-card,
body.dark-mode .chart-card,
body.dark-mode .table-card {
    background: #182630 !important;
    border-color: #2c3d49 !important;
    color: #f1f5f9 !important;
}

/* Tajuk dalam panel */
body.dark-mode .panel-title,
body.dark-mode .card-title,
body.dark-mode .section-title {
    color: #f8fafc !important;
}

/* Label statistik */
body.dark-mode .stat-label {
    color: #b8c5d1 !important;
}

/* Nombor statistik */
body.dark-mode .stat-value {
    color: #ffffff !important;
}

/* Teks kecil */
body.dark-mode small,
body.dark-mode .text-muted,
body.dark-mode .muted {
    color: #aebbc6 !important;
}


/* =====================================================
   JADUAL STATISTIK
   ===================================================== */

body.dark-mode table {
    color: #e8eef3 !important;
    background: #182630 !important;
}

body.dark-mode table thead {
    background: #223440 !important;
}

body.dark-mode table thead th {
    color: #f5f7fa !important;
    background: #223440 !important;
    border-color: #52636f !important;
}

body.dark-mode table tbody {
    background: #182630 !important;
}

body.dark-mode table tbody tr {
    background: #182630 !important;
    color: #e3eaf0 !important;
    border-color: #40515d !important;
}

body.dark-mode table tbody tr:nth-child(even) {
    background: #1b2b35 !important;
}

body.dark-mode table tbody tr:hover {
    background: #263d4b !important;
}

body.dark-mode table tbody td {
    color: #e3eaf0 !important;
    border-color: #40515d !important;
}


/* =====================================================
   EXPORT CSV
   ===================================================== */

body.dark-mode .export-btn,
body.dark-mode .btn-export {
    color: #4db3ff !important;
}


/* =====================================================
   FORM
   ===================================================== */

body.dark-mode input,
body.dark-mode select,
body.dark-mode textarea {
    background: #17252e !important;
    color: #f5f7fa !important;
    border-color: #3b4d59 !important;
}

body.dark-mode input::placeholder,
body.dark-mode textarea::placeholder {
    color: #8796a2 !important;
}

body.dark-mode label {
    color: #dce5eb !important;
}


/* =====================================================
   LINK
   ===================================================== */

body.dark-mode a {
    color: #4db3ff !important;
}


/* =====================================================
   REPORT
   ===================================================== */

body.dark-mode .report-card,
body.dark-mode .summary-card {
    background: #182630 !important;
    color: #eaf0f4 !important;
}

body.dark-mode .report-card p,
body.dark-mode .summary-card p {
    color: #c4d0d8 !important;
}


/* =====================================================
   CHART
   ===================================================== */

body.dark-mode .chart-title {
    color: #ffffff !important;
}

body.dark-mode .chart-subtitle {
    color: #b8c5d1 !important;
}


/* =====================================================
   SETTINGS
   ===================================================== */

body.dark-mode .settings-panel {
    background: #182630 !important;
    color: #ffffff !important;
}

body.dark-mode .setting-label {
    color: #e8eef3 !important;
}

body.dark-mode .setting-description {
    color: #aebbc6 !important;
}


/* =====================================================
   POPUP / MAP
   ===================================================== */

body.dark-mode .ol-popup {
    background: #182630 !important;
    color: #ffffff !important;
}

body.dark-mode .ol-popup h3,
body.dark-mode .ol-popup strong {
    color: #ffffff !important;
}

body.dark-mode .ol-popup p {
    color: #d3dde4 !important;
}
