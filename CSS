.language-setting select{

    border:1px solid #dce4e9;

    background:white;

    padding:8px 10px;

    border-radius:7px;

    font-size:12px;

    color:#34495e;

    outline:none;

    cursor:pointer;

}

body.dark .language-setting select{

    background:#25343f;

    color:white;

    border-color:#3b4c58;

}
